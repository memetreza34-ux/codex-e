{
  "name": "codex-e-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "studio": "remotion studio src/remotion/index.ts --port=3141 --no-open",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node scripts/validate-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "render": "node scripts/cli.mjs render",
    "qa": "node scripts/cli.mjs qa",
    "project:new": "node scripts/cli.mjs new",
    "skills:sync": "node scripts/sync-skills.mjs",
    "audio:normalize": "node scripts/cli.mjs audio",
    "postinstall": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src scripts tests docs package.json studio.config.json tsconfig.json vite.config.ts remotion.config.ts README.md AGENTS.md"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.185.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.8.1",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
